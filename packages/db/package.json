{
    "name": "@ts-template/db",
    "version": "0.0.0",
    "type": "module",
    "files": [
        "dist",
        "drizzle"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "generate": "drizzle-kit generate --config=src/drizzle.config.ts",
        "migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts",
        "seed": "node --env-file-if-exists=.env --import tsx src/scripts/seed.ts"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "^0.31.10",
        "tsx": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@ts-template/types": "workspace:*",
        "drizzle-orm": "catalog:",
        "pg": "catalog:"
    }
}
