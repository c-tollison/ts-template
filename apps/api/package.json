{
    "name": "@ts-template/api",
    "type": "module",
    "files": [
        "dist",
        "config"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./client": {
            "development": "./src/client.ts",
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        }
    },
    "scripts": {
        "dev": "concurrently -n server,types -c blue,yellow \"pnpm dev:server\" \"pnpm dev:types\"",
        "dev:server": "tsx watch --conditions=development --env-file=.env src/index.ts",
        "dev:types": "tsc --watch --preserveWatchOutput",
        "build": "tsc",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "@hono/zod-validator": "^0.9.1",
        "@ts-template/db": "workspace:*",
        "@ts-template/types": "workspace:*",
        "hono": "catalog:",
        "pino": "^10.3.1",
        "smol-toml": "^1.8.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "concurrently": "catalog:",
        "pino-pretty": "^13.1.3",
        "tsx": "catalog:",
        "typescript": "catalog:"
    }
}
