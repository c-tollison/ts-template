# Selects the config/config.toml table: `local` or `deployed`.
STAGE=local

# Optional. Overrides the pino level (trace|debug|info|warn|error|fatal).
# LOG_LEVEL=debug

# Postgres connection string. Matches docker-compose.local.yml at the repo root.
DATABASE_URL=postgres://ts_template:ts_template@localhost:5433/ts_template
