# Production env for docker-compose.yml. Copy to ~/ts-template/.env on the VPS.
STAGE=deployed
# Output of `scripts/create-db.sh ts-template` in vps-infra.
DATABASE_URL=
# Image tag to run. Written by vps-infra's deploy.sh on every deploy.
# Set to an older sha-<commit> and `docker compose up -d` to roll back.
IMAGE_TAG=
