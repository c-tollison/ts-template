{
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!**/node_modules",
            "!.vscode",
            "!**/.vscode",
            "!.claude",
            "!**/.claude",
            "!dist",
            "!**/dist",
            "!build",
            "!**/build",
            "!packages/db/drizzle/meta"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "es5",
            "semicolons": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "json": {
        "formatter": {
            "enabled": true
        },
        "parser": {
            "allowComments": true,
            "allowTrailingCommas": true
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [
                            [":NODE:", ":BUN:"],
                            ":BLANK_LINE:",
                            ["PACKAGE:", "!@ts-template/**"],
                            ":BLANK_LINE:",
                            "@ts-template/**",
                            ":BLANK_LINE",
                            "@/**",
                            ":BLANK_LINE:",
                            [":PATH:"]
                        ]
                    }
                }
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.d.ts"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.vue"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": "off",
                        "noUnusedImports": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.svg"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noSvgWithoutTitle": "off"
                    }
                }
            }
        },
        {
            "includes": ["apps/api/src/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "error"
                    }
                }
            }
        },
        {
            "includes": ["apps/web/src/components/shadcn-components/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off",
                        "useVueMultiWordComponentNames": "off"
                    }
                }
            }
        }
    ]
}
