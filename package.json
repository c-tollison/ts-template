{
    "name": "ts-template",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": "^24.12.0",
        "pnpm": "^11.9.0"
    },
    "engineStrict": true,
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "biome:fix": "biome check --write --no-errors-on-unmatched",
        "prettier:fix": "prettier --write --log-level warn",
        "check": "pnpm biome:fix . && pnpm prettier:fix \"**/*.vue\"",
        "check:ci": "biome check . && prettier --check \"**/*.vue\"",
        "copy": "node scripts/copy-project.mjs",
        "dev": "pnpm local:start && concurrently -n api,web -c blue,green \"pnpm --filter @ts-template/api dev\" \"pnpm --filter @ts-template/web dev\"",
        "add-component": "node scripts/add-component.mjs",
        "build": "pnpm -r --stream run build",
        "local:start": "docker compose -f docker-compose.local.yml up -d --wait",
        "local:up": "pnpm local:start && pnpm db:migrate && pnpm db:seed",
        "local:down": "docker compose -f docker-compose.local.yml down",
        "local:reset": "docker compose -f docker-compose.local.yml down -v && pnpm local:up",
        "db:generate": "pnpm --filter @ts-template/db generate",
        "db:migrate": "pnpm --filter @ts-template/db migrate",
        "db:seed": "pnpm --filter @ts-template/db seed"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "concurrently": "catalog:",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.6"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx,json,css}": [
            "pnpm biome:fix"
        ],
        "*.vue": [
            "pnpm biome:fix",
            "pnpm prettier:fix"
        ]
    }
}
